{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "type": "object",
  "required": [
    "admin",
    "anchor_aust_address",
    "code_id_staking",
    "denom",
    "label_staking",
    "loterra_address",
    "money_market_address",
    "unbonding_period"
  ],
  "properties": {
    "admin": {
      "$ref": "#/definitions/CanonicalAddr"
    },
    "anchor_aust_address": {
      "$ref": "#/definitions/CanonicalAddr"
    },
    "code_id_staking": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "denom": {
      "type": "string"
    },
    "label_staking": {
      "type": "string"
    },
    "loterra_address": {
      "$ref": "#/definitions/CanonicalAddr"
    },
    "money_market_address": {
      "$ref": "#/definitions/CanonicalAddr"
    },
    "unbonding_period": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>",
      "type": "string"
    },
    "CanonicalAddr": {
      "$ref": "#/definitions/Binary"
    }
  }
}
